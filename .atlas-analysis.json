  "keyFeatures": [
    "Pre-signature transaction risk evaluation returning ALLOW, REVIEW, or BLOCK decisions",
    "5-layer risk engine: network validation, scam feed checks, wallet intelligence, contract analysis, and simulation",
    "Risk scoring 0–100 with LOW/MEDIUM/HIGH/CRITICAL levels and detailed findings",
    "SafeSend: time-locked ERC20 transfers with a cancellation window on Arbitrum Sepolia",
    "Programmable Escrow: buyer/seller escrow with acceptance deadlines, dispute resolution, and automatic fee handling",
    "Multisig Escrow: threshold-gated fund release requiring multiple approver signatures",
    "API key authentication with per-key rate limits and scoped permissions",
    "Supported chains: Ethereum, BNB, Polygon, Base, Arbitrum, Optimism, Solana",
    "Fail-closed architecture: errors default to blocking rather than allowing",
    "Full audit trail: canonical intent hashing, request IDs, decision evidence storage"
  ],
  "publicApiSurface": [
    "POST /api/check-transaction — core risk-check endpoint returning risk_score, risk_level, findings, recommended_action",
    "GET /health — liveness check returning {status, service}",
    "GET /docs — Swagger/OpenAPI interactive documentation",
    "SafeSend.createSafeSend(recipient, token, amount, releaseTime)",
    "SafeSend.cancelSafeSend(transferId)",
    "SafeSend.releaseSafeSend(transferId)",
    "SafeSend.getSafeSend(transferId)",
    "SafeSend.previewFee(amount)",
    "Escrow.createEscrow(seller, token, amount, acceptanceDeadline)",
